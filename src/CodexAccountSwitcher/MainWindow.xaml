<Window x:Class="CodexAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Account Switcher"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CODEX ACCOUNT SWITCHER"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="Switch accounts without replacing sessions, skills or config"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh usage"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         ToolTip="Account alias, for example Daniel 1" />

                <Button Grid.Column="2"
                        Content="Import current"
                        Command="{Binding ImportCurrentCommand}" />

                <Button Grid.Column="4"
                        Content="Add another account"
                        Command="{Binding AddAccountCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Accounts"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <TextBlock DockPanel.Dock="Top"
                               Text="AUTH FILE marks the saved account. Use account also refreshes Codex in detected VS Code windows after your turns finish."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,-6,0,12" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="0,0,0,12"
                                            Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold" />

                                                    <TextBlock Text="  AUTH FILE"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               ToolTip="This account is saved in the Codex auth file. A running VS Code worker may still have another account cached.">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Text="  ★ BEST AVAILABLE"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SecondaryTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Text="{Binding IdentityText}"
                                                           Margin="0,3,0,12"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                                <TextBlock Text="{Binding PrimaryUsageText}"
                                                           FontWeight="SemiBold" />
                                                <ProgressBar Height="7"
                                                             Margin="0,5,0,3"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding PrimaryRemainingValue, Mode=OneWay}" />
                                                <TextBlock Text="{Binding PrimaryResetText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Margin="0,0,0,10" />

                                                <TextBlock Text="{Binding SecondaryUsageText}"
                                                           FontWeight="SemiBold" />
                                                <ProgressBar Height="7"
                                                             Margin="0,5,0,3"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding SecondaryRemainingValue, Mode=OneWay}" />
                                                <TextBlock Text="{Binding SecondaryResetText}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                                <TextBlock Text="{Binding UsageStatusText}"
                                                           FontSize="11"
                                                           Margin="0,10,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                                <Button Content="Edit alias"
                                                    Click="EditAlias_Click"
                                                    MinWidth="105"
                                                    Margin="0,0,0,8" />
                                                <Button Content="Use account"
                                                    Command="{Binding DataContext.ActivateAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    MinWidth="105" />
                                                </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Diagnostics"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="CODEX_HOME"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.CodexHome}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="Codex executable"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.CodexExecutable}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="Codex version"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.CodexVersion}"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="Auth file"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.AuthCandidate}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="VS Code processes"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.VsCodeProcessCount}"
                                   Margin="0,2,0,12" />

                        <TextBlock Text="Codex-like processes"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding Diagnostics.CodexProcessCount}"
                                   Margin="0,2,0,0" />

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="6"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Credentials are DPAPI-protected per Windows user. Adding an account uses a temporary CODEX_HOME, so the currently active Codex session is not logged out." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
