<Application x:Class="CodexAccountSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111318" />
        <SolidColorBrush x:Key="PanelBrush" Color="#191C22" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#2B3038" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F5F7" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA3AD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5B8CFF" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
